{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "mail-relay"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "description": "Messages the mail relay accepted and delivered. Panels show nothing until the relay reports.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Messages queued",
          "description": "How many messages wait for delivery right now. Up to 50 is normal. Red from 50 means delivery falls behind. No data means the relay sent no metrics in the last five minutes.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(relay_queue_depth)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 50,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "noValue": "No data",
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Messages delivered",
          "description": "Messages the relay delivered per second, averaged over five minutes. A line that drops to zero means delivery stopped. A gap means the relay sent no metrics.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(rate(relay_delivered_total[5m]))"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "lineWidth": 2,
                    "fillOpacity": 20
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Delivery",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 4,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 4,
                        "width": 24,
                        "height": 8,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "mail"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "1m",
        "5m"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Mail relay",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "never",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "prometheus"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Data source",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      }
    ]
  }
}
