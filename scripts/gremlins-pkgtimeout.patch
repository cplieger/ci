+func TestMutantTimeoutFromItsPackage(t *testing.T) {
+	const moduleElapsed = 200 * time.Second
+	pkgElapsed := map[string]time.Duration{
+		"example.com/slow": 10 * time.Second,
+		"example.com/fast": 490 * time.Millisecond,
+	}
+	testCases := []struct {
+		name        string
+		pkg         string
+		intMode     bool
+		wantTimeout time.Duration
+	}{
+		{
+			name:        "coefficient times the package's own test time",
+			pkg:         "example.com/slow",
+			wantTimeout: 10 * time.Second * 12,
+		},
+		{
+			name:        "a fast package gets the floor",
+			pkg:         "example.com/fast",
+			wantTimeout: engine.MinPackageTimeout,
+		},
+		{
+			name:        "a package the coverage pass did not time gets the module figure",
+			pkg:         "example.com/untimed",
+			wantTimeout: moduleElapsed * 12,
+		},
+		{
+			name:        "integration mode runs every package, so it gets the module figure",
+			pkg:         "example.com/slow",
+			intMode:     true,
+			wantTimeout: moduleElapsed * 12,
+		},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			viperSet(map[string]any{
+				configuration.UnleashIntegrationMode:       tc.intMode,
+				configuration.UnleashTimeoutCoefficientKey: 12,
+			})
+			defer viperReset()
+
+			mod := gomodule.GoModule{
+				Name:       "example.com",
+				Root:       ".",
+				CallingDir: ".",
+			}
+			wdDealer := newWdDealerStub(t)
+			holder := &commandHolder{}
+			mjd := engine.NewExecutorDealer(mod, wdDealer, moduleElapsed,
+				engine.WithExecContext(fakeExecCommandSuccessWithHolder(holder)),
+				engine.WithPackageElapsed(pkgElapsed))
+			mut := &mutantStub{
